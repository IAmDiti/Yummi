# Copy to .env and fill in from your Supabase project (Settings -> API).
# These two values are safe to ship in a mobile app — the anon key only lets the
# app call your Edge Functions; your ANTHROPIC_API_KEY lives as a Supabase secret
# and never touches the client.
#
# Leave BOTH blank/unset to run the app in demo (mock) mode with canned responses.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
